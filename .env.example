# ============================================================================
# PeakFlow 秒杀商城 · 环境变量模板
# ----------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按环境填写真实值（.env 请加入 .gitignore，不要提交到版本库）
#   3. 加载方式（三选一）：
#      · 本机跑后端   → IDE 的 Run Configuration 里逐条填 Environment variables，
#                        或终端 `set -a; source .env; set +a` 后再启动
#      · Docker Compose → 在 docker-compose.yml 的服务上写 `env_file: .env`
#      · CI / 生产     → 由部署平台（K8s Secret / 云厂商环境变量）注入，不要落盘
#
#   ⚠️ 本项目未引入 spring-dotenv，Spring Boot **不会自动读取 .env 文件**。
#      上面三种方式都是把变量注入到「进程环境」，Spring 通过
#      ${VAR:default} 占位符读取（见 backend/src/main/resources/application*.yml）。
#
# 变量命名与落点：
#   · 与 Spring 官方一致的（SPRING_/LOG_/DB_ 前缀）→ 直接覆盖同名配置项
#   · 项目自定义的（JWT_/MOCK_PAY_/OSS_/CORS_）→ 由 yml 中的占位符显式引用
#
# 安全约定（贯穿全项目）：
#   · 密钥、口令、AccessKey 在 yml 里一律写成 ${VAR:}（**无兜底默认值**），
#     未注入就直接启动失败 —— 宁可不启动，也不要带着空密钥跑起来
#   · dev / test 为了开箱可用给了本地默认值，prod 全部留空，必须显式注入
#   · 本文件中出现的所有示例值都**仅供本地开发**，生产环境严禁直接沿用
# ============================================================================


# ---------------------------------------------------------------------------
# 一、运行环境（必填）
# ---------------------------------------------------------------------------
# 激活哪套 profile，三选一：dev / test / prod
#   dev  → MySQL peakflow_dev  + Redis db0 + 日志 ./logs/dev
#   test → MySQL peakflow_test + Redis db1 + 日志 ./logs/test
#   prod → MySQL peakflow_prod + Redis db2 + 日志 ./logs/prod（并对安全开关做收紧）
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# 二、Docker Compose 端口（本地中间件，仅 compose 与 .env 之间共享）
# ---------------------------------------------------------------------------
# 下面几个端口同时被 docker-compose.yml 的 ports 映射和 Spring 的
# DB_PORT / REDIS_PORT 复用，是同一份事实来源，改一处即可。
#
# ⚠️ MySQL 为什么不是 3306：
#   本机 3306 常被「Windows 服务 MySQL80」占用，且那个实例里可能存着
#   其他项目的库（fastapi / healthsmart / sakila 等）。PeakFlow 中间件
#   统一走独立端口，避免与它们互相干扰。想用 3306 就把 DB_PORT 改掉，
#   并确保该端口没有别的 MySQL 在监听。
DB_PORT=3307
REDIS_PORT=6380
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
# 两个后端实例各自发布到宿主机的端口。
# 浏览器访问一律走前端 nginx 的反代（upstream 用容器网络），这两个端口
# 主要供「单独 curl 验证某个实例」用；本机直接 npm run dev 时不受影响。
BACKEND1_PORT=8080
BACKEND2_PORT=8081
FRONTEND_PORT=3001

# ---------------------------------------------------------------------------
# 三、MySQL（必填）
# ---------------------------------------------------------------------------
# 三个环境的库名由 profile 决定（peakflow_dev / peakflow_test / peakflow_prod），
# 这里填的 DB_NAME 会覆盖 profile 中的默认值，一般情况下留空即可。
DB_HOST=127.0.0.1
# 与上面的 Docker Compose 段保持一致（容器把 3306 映射到宿主的 DB_PORT）
DB_PORT=3307
# 不填则用 profile 默认库名；跨环境部署时建议显式指定
DB_NAME=peakflow_dev
DB_USERNAME=
DB_PASSWORD=
# 生产建议开启 TLS；本地 MySQL 通常未配证书，dev/test 保持 false
# 注意：dev/test 的 JDBC 串未拼接 useSSL，只有 prod 会读取该变量
DB_USE_SSL=false

# ---------------------------------------------------------------------------
# 四、Redis（必填）
# ---------------------------------------------------------------------------
# 三个环境复用同一个 Redis 实例，仅用不同的 logical database 做隔离。
# 若为每套环境各起一个实例，直接改 REDIS_PORT / REDIS_DATABASE 即可。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# dev=0 / test=1 / prod=2，与 profile 默认值一致，通常无需覆盖
REDIS_DATABASE=0

# ---------------------------------------------------------------------------
# 五、RocketMQ（秒杀异步下单 / 订单超时关单，必填）
# ---------------------------------------------------------------------------
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
# 生产者组：同一集群内不同应用必须用不同组名，否则会互相抢消息
ROCKETMQ_PRODUCER_GROUP=peakflow-producer-group

# ---------------------------------------------------------------------------
# 六、JWT（敏感，必填）
# ---------------------------------------------------------------------------
# 签名密钥：长度 ≥ 32 字节的高强度随机串（HS256 要求密钥不短于 256 bit）。
# 生成方式：openssl rand -base64 48
# 严禁提交真实值；轮换密钥会使所有已签发 token 立即失效（等同于全站强制重登）。
JWT_SECRET=
# token 有效期（秒），默认 86400 = 24 小时
JWT_EXPIRATION=86400

# ---------------------------------------------------------------------------
# 七、MockPay 模拟第三方支付（本地闭环联调，开发环境必填）
# ---------------------------------------------------------------------------
# 与 MockPay 之间的验签密钥（充当真实世界里的支付宝商户密钥）。
# 本地示例值：peakflow-mock-pay-secret-key-2026
# Postman 环境变量 mockPaySecret 必须与这里保持一致，否则资金链路全部验签失败。
MOCK_PAY_SECRET=
# 收银台地址：发起支付时返回给前端，由前端跳转
MOCK_PAY_CASHIER_URL=http://127.0.0.1:8080/mock-pay/cashier
# 异步回调地址（第三方 → 我方）：真实场景必须是自己可被公网访问的 HTTPS 域名
MOCK_PAY_NOTIFY_URL=http://127.0.0.1:8080/pay/notify
# 同步跳转地址（用户付款后浏览器跳回，仅展示、不改订单状态）
MOCK_PAY_RETURN_URL=http://localhost:3000/orders
# 第三方退款接口地址（我方 → 第三方）
MOCK_PAY_REFUND_URL=http://127.0.0.1:8080/mock-pay/refund
# 退款结果回调地址（第三方 → 我方）
MOCK_PAY_REFUND_NOTIFY_URL=http://127.0.0.1:8080/refund/notify

# ---------------------------------------------------------------------------
# 八、文件上传（阿里云 OSS，按需）
# ---------------------------------------------------------------------------
# 配了 OSS_ACCESS_KEY_ID 就走阿里云 OSS；**留空则自动降级为本地磁盘存储**，
# 文件写到 APP_UPLOAD_LOCAL_DIR 并通过后端 /uploads/** 对外提供 ——
# 也就是说没买 OSS 也能正常用头像/商品图上传，只是文件存在本机。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=peakflow
OSS_REGION=cn-beijing

# ↓ 仅「降级为本地存储」时生效
# 降级文件的落盘目录（相对后端启动目录；容器内是 /app/uploads）
APP_UPLOAD_LOCAL_DIR=./uploads
# 降级后返回给前端的 URL 前缀，必须是浏览器能访问到的后端地址。
# 容器部署时若前端经 nginx 反代访问后端，改成外部可访问的域名/地址
APP_UPLOAD_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# 九、CORS（跨域，生产必填）
# ---------------------------------------------------------------------------
# 允许的前端来源，多个用英文逗号分隔，不要带结尾斜杠。
# dev 默认：http://localhost:3000,http://127.0.0.1:3000
# prod 默认留空 = 拒绝所有跨域请求，必须显式配置真实域名。
# ⚠️ 严禁使用 *（放通配符等于放弃同源策略保护）。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 十、日志（可选）
# ---------------------------------------------------------------------------
# 日志根目录，各环境默认 ./logs/{dev|test|prod}
LOG_PATH=./logs/dev
# 全局日志级别：TRACE / DEBUG / INFO / WARN / ERROR
LOG_LEVEL_ROOT=INFO
# 业务包 com.zhou.peakflow 的日志级别（dev 默认 DEBUG，便于排障）
LOG_LEVEL_APP=DEBUG

# ---------------------------------------------------------------------------
# 十一、多实例部署（雪花 ID 机器位，起两个以上后端实例时必填）
# ---------------------------------------------------------------------------
# 后端按「2 个实例」部署：backend1 / backend2，共用同一镜像与同一份配置，
# 唯一必须区分的就是雪花 ID 的机器位 —— 两实例用同一个 workerId 时，
# 同一毫秒内会生成完全相同的 ID（秒杀单号、支付单号都靠它），且不会立刻报错。
#
# 取值范围：worker-id 0~31、datacenter-id 0~31；越界会在启动期直接失败。
# compose 里已为两个实例分别写死 1 / 2（见 docker-compose.yml），
# 只有「以 java -jar 手工起多实例」时才需要在这里改。
SNOWFLAKE_WORKER_ID=1
# 跨机房部署才需要区分，单机房的多个实例填同一个值即可
SNOWFLAKE_DATACENTER_ID=1
