<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 从application.yml读取配置，yml可以覆盖路径与应用名，yml没配置就用默认值 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="sys"/>

    <!-- 注册 SkyWalking %tid 转换器（apm-toolkit-logback-1.x 提供），输出链路 trace id -->
    <conversionRule conversionWord="tid" converterClass="org.apache.skywalking.apm.toolkit.log.logback.v1.x.LogbackPatternConverter"/>

    <!-- 日志输出格式：携带traceId链路追踪 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{20} traceId:%X{traceId} %tid - %msg%n"/>

    <!--===================== 控制台输出 =====================-->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--===================== INFO 文件输出：记录DEBUG、INFO、WARN，过滤ERROR =====================-->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-info.log</file>

        <!-- 时间+大小双滚动策略 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-info.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单文件最大100M -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 保留7天 -->
            <maxHistory>7</maxHistory>
            <!-- 日志总上限 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <!-- 过滤器：过滤掉ERROR，DEBUG/INFO/WARN全部保留 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--===================== ERROR 文件输出：只记录ERROR级别 =====================-->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <!-- 过滤器：只接收ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- SkyWalking 上报 Appender：只上报 WARN/ERROR 日志 -->
    <appender name="SKYWALKING_LOG" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <!-- 过滤器：只允许WARN和ERROR上报SkyWalking，INFO/DEBUG直接过滤掉 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- 异步包装SkyWalking上报，防止网络问题阻塞业务线程 -->
    <appender name="ASYNC_SKYWALKING" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <!-- 队列满了可以丢弃，WARN/ERROR丢失概率低；如果不想丢可以改成0，但是队列满会阻塞业务 -->
        <discardingThreshold>10</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="SKYWALKING_LOG"/>
    </appender>

    <!--===================== 异步包装 INFO_FILE：业务日志，队列满可丢弃低级别日志保护秒杀业务 =====================-->
    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <!-- 队列剩余容量小于该值，丢弃TRACE、DEBUG，INFO/WARN保留 -->
        <discardingThreshold>20</discardingThreshold>
        <!-- 不采集调用栈行号，提升性能；如果需要%line行号改为true -->
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <!--===================== 异步包装 ERROR_FILE：错误日志，禁止丢弃任何日志 =====================-->
    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <!-- discardingThreshold=0：关闭丢弃策略，错误日志一条都不能丢；队列满会阻塞业务线程 -->
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="ERROR_FILE"/>
    </appender>


    <!-- 环境区分配置 -->
    <springProfile name="dev">
        <!-- 业务主包开启DEBUG，框架保持INFO，不会大量刷屏 -->
        <logger name="com.zhou.peakflow" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </logger>
        <!-- mapper打印SQL日志 -->
        <logger name="com.zhou.peakflow.mapper" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </logger>

        <!-- root全局级别INFO，第三方框架只输出INFO及以上 -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </root>
    </springProfile>

    <springProfile name="test">
        <!-- 业务主包开启DEBUG，框架保持INFO，不会大量刷屏 -->
        <logger name="com.zhou.peakflow" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>



        </logger>
        <!-- mapper打印SQL日志 -->
        <logger name="com.zhou.peakflow.mapper" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>


        </logger>

        <!-- root全局级别INFO，第三方框架只输出INFO及以上 -->
        <root level="INFO">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>

        </root>
    </springProfile>

    <!-- prod生产环境：全部INFO，关闭SQL打印，关闭控制台输出 -->
    <springProfile name="prod">
        <logger name="com.zhou.peakflow" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </logger>
        <logger name="com.zhou.peakflow.mapper" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </logger>

        <root level="INFO">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_SKYWALKING"/> <!-- 增加SkyWalking上报 -->
        </root>
    </springProfile>

</configuration>